# HTTP administrator credential for /admin/*.
# Generate one random value of at least 32 characters.
KEYZORI_ADMIN_API_KEY=replace_with_at_least_32_random_characters
# Optional comma-separated previous keys for zero-downtime rotation.
# KEYZORI_ADMIN_API_KEYS=previous_random_admin_secret

# URL-safe password used by the Docker Compose PostgreSQL service.
KEYZORI_POSTGRES_PASSWORD=replace_with_a_url_safe_random_password

# Keyzori server
KEYZORI_SERVER_HOST=0.0.0.0
KEYZORI_SERVER_PORT=3000
KEYZORI_DATABASE_URL=postgresql://user:password@localhost:5432/keyzori
KEYZORI_REDIS_URL=redis://localhost:6379

# Only enable when direct access is blocked and requests come through a trusted proxy.
KEYZORI_TRUST_PROXY_HEADERS=false
# Select x-forwarded-for, cf-connecting-ip, x-real-ip, or * to reconcile all present headers.
KEYZORI_TRUSTED_PROXY_HEADER=x-forwarded-for
# Use * only when a firewall prevents every direct client connection.
# KEYZORI_TRUSTED_PROXY_CIDRS=10.0.0.0/8,2001:db8::/32
# KEYZORI_TRUSTED_PROXY_CIDRS=*

KEYZORI_OPENAPI_ENABLED=true
KEYZORI_RATE_LIMIT_PER_MINUTE=60
KEYZORI_LICENSE_RATE_LIMIT_PER_MINUTE=30
KEYZORI_RATE_LIMIT_PER_IP_PER_MINUTE=6000
KEYZORI_MAX_REQUEST_BODY_BYTES=65536

KEYZORI_EVENT_RETENTION_DAYS=30

# Optional Stripe subscription synchronization. Leave both unset to disable.
# KEYZORI_STRIPE_SECRET_KEY=sk_live_...
# KEYZORI_STRIPE_WEBHOOK_SECRET=whsec_...
