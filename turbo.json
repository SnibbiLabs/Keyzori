{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"passThroughEnv": ["*"],
			"persistent": true
		},
		"start": {
			"cache": false,
			"passThroughEnv": ["*"],
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		}
	}
}
